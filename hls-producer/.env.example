# Copy to .env next to docker-compose.yaml.

# Segments kept in each playlist. A deeper playlist starts further behind the
# live edge. One launch per depth, one-second segments: 12 -> 826 ms,
# 8 -> 1429 ms, 6 -> 986 ms, 4 -> 1286 ms. Depth stops mattering past four.
HLS_LIST_SIZE=6

# Only used by the camera-config service, to assert the keyframe interval and
# audio codec once at start.
CAM_USER=admin
CAM_PASS=change-me
